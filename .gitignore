# .dep files
test/**/*.dep
src/**/*.dep

# .o files
test/**/*.o
src/**/*.o

# .so files (dynamic libraries)
test/**/*.so

# VIM related metadata
test/**/*.vim
test/**/*.swp

# directories with 'linux' in their names.
# directories with 'test' or 'Test' in their names.
test/**/*linux*
test/**/*test*
test/**/*Test*

src/**/*linux*

# binary directories (containing, e.g., *.so files)
test/**/bin/*

# large directories (and obviously their content)
test/myBekaert-v2.0

# directories with 'log.' or '.log' in their start or end
test/**/log.*
test/**/*.log
test/**/log

src/**/log.*
src/**/*.log
src/**/log

# directories with 'log.' or '.log' in their start or end
test/**/lnInclude
src/**/lnInclude
