set term epslatex
set output "src/error_order_schemes.tex"

#------------------------------------------------------------------------------#
# No LaTeX typesetting for xlabel, etc.
#------------------------------------------------------------------------------#
#set term postscript enhanced color
#set output "error_order.ps"
#------------------------------------------------------------------------------#

unset xrange
unset yrange

set x2range

set key bottom right

#set xrange [0:225] # Top x for N
set logscale y 10
set logscale x 10

set xlabel "$N_{\\mathrm{cells}}$"
set ylabel "$E_{\\mathrm{L}_1}$"

plot \
     '-' u ($2):3:xtic(1) w l dt 2 t "", \
     '-' u ($2):3:xtic(1) w l dt 2 t "$2^{nd}$ Order", \
     '-' u ($2):3:xtic(1) w l dt 3 t "$1^{st}$ Order", \
     '-' u ($2):3:xtic(1) w p pt 7 ps 3 t "linear", \
     '-' u ($2):3:xtic(1) w p pt 9 ps 3 t "downwind", \
     '-' u ($2):3:xtic(1) w p pt 11 ps 3 t "cubic", \
     #'-' u ($2):3:xtic(1) w p pt 9 ps 3 t "Nearest cell", \
     #'-' u ($2):3:xtic(1) w p pt 11 ps 3 t "Weighted average" \
     #'-' u ($2):3:xtic(1) w l t "1st Order", \
     #'-' u ($2):3:xtic(1) w l t "Linear/Crank-Nicolson", \
     #'-' u ($2):3:xtic(1) w l t "lambda = 0.99", \
     #'-' u ($2):3:xtic(1) w l t "lambda = 0.90", \
     #'-' u ($2):3:xtic(1) w l t "Linear", \
     #'-' u ($2):3:xtic(1) w l t "Downwind", \
    # N        # Delta        # L1 Err        # Max Error

    #25           1.0/25.0      0.000229544 
    #50           1.0/50.0      0.000114772 
    #100          1.0/100.0     0.000057386
    #200          1.0/200.0     0.000028693
    #e
    #25           1.0/25.0       0.000229544 
    #50           1.0/50.0       6.74837e-05 
    #100          1.0/100.0      4.05477e-05 
    #200          1.0/200.0      3.87974e-05
    #e
    # 3rd order
    #25            0.04    0.000883219
    #50            0.02    0.000110402375
    #100           0.01    0.000013800296875
    #200           0.005   1.725037109375E-06
    #e
    # 2nd order - cubic scheme
    25	0.04	0.000338609	0.000338609
    50	0.02	8.30E-05	0.00008465225
    100	0.01	2.06E-05	0.0000211630625
    200	0.005	5.35E-06	0.000005290765625
    e
    # 2nd order
    25            0.04    0.000883219
    50            0.02    0.00022080475
    100           0.01    0.00005520118
    200           0.005   0.000013800295
    e
    # 1st order
    25            0.04   0.00351012
    50            0.02   0.00175506
    100           0.01   0.00087753
    200           0.005  0.00043877
    e
    # linear/backward - small deltaT
    # N        # Delta        # L1 Err        # Max Error
    25	       0.04           0.000883219 0.0433537
    50         0.02   	      0.000219254 0.0109263
    100        0.01           5.43327e-05 0.00273664
    200        0.005          1.36939e-05 0.000693356
    e
    # downwind/backward - small deltaT
    # N        # Delta        # L1 Err        # Max Error
    25	       0.04           0.00220272      0.0675567
    50         0.02   	      0.00110898      0.0340111
    100        0.01           0.000554132     0.0170834
    200        0.005          0.000277097     0.00855664
    e
    # blended/Euler - small deltaT
    # N        # Delta        # L1 Err        # Max Error
    #25		 0.04  0.000225894   0.00721301 
    #50           0.02  0.000120257   0.00358295    
    #100 	 0.01  5.04262e-05   0.00151439 
    #200          0.005  2.04849e-05  0.000672303 
    #e
    # Blended, lambda = 0.90
    #25              0.04   0.00121044  0.0486322
    #50              0.02   0.0004526   0.0135848
    #100             0.01   0.0002001   0.0064522
    #200              0.005  0.0017044   0.424592
    #e
    # Cubic, backward
    # N        # Delta        # L1 Err        # Max Error
      25         0.04           0.000338609     0.0226526
      50         0.02           8.30173e-05     0.00554543
      100        0.01           2.06145e-05     0.00137664
      200        0.005          5.35049e-06     0.000353356
