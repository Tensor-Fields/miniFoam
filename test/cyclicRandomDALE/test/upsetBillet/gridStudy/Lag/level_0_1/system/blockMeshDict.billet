// start of blockMeshDict

convertToMeters 0.001;

vertices
(
    //- dimension in mm
    (0 0 0)
    (15 0 0)
    (15 10 -10)
    (0  10 -10)
    (15 10 0)
    (0  10 0)

    (15 0 0)
    (16 0 0)
    (16 20 -0.17453070996749)
    (15 20 -0.17453070996749)
    (16 20 0.17453070996749)
    (15 20 0.17453070996749)

    (0 0 -10)
    (15 0 -10)
    (15 10 -10)
    (0  10 -10)
);

blocks
(
    //hex (0 1 2 3 0 1 4 5) billet (24 24 1) simpleGrading (1 1 1)
    hex (12 13 14 15 0 6 4 5) billet (24 24 24) simpleGrading (1 1 1)
    //hex (6 7 8 9 6 7 10 11) die (1 1 1) simpleGrading (1 1 1)
);

edges
(
);

