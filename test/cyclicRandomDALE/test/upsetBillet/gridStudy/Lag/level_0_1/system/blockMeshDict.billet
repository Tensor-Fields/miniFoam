FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/polyMesh";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Model Description
// Axisymmetric cylinder mesh with compression die

// Setup m4 stuff



// define geometry in mm

 // half cylinder height
 // cylinder radius
 // angle of wedge in degrees
 // die thickness
 // die width

// calculated quantities




// define mesh density
