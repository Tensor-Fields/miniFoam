FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Note: remeshWireFvMesh derives from layerAdditionFvMesh
//dynamicFvMesh   layerAdditionFvMesh;
dynamicFvMesh   solidDynamicFvMesh;
//solver banana;

"solidDynamicFvMeshCoeffs|layerAdditionFvMeshCoeffs"
{
    // Enable remeshing
    remeshWire yes;

    keepIntermediateMeshesAndFields yes;

    // Remeshing-specific settings
    remeshWireFvMeshCoeffs
    {
        // Time step remeshing frequency: 1 means every time step
        remeshFrequency 1;

        // Name of wire contact patch
        wireContactPatchName wireContact;

        // Name of the wire downstream patch
        wireDownstreamPatchName wireDownstream;

        // The wire is extruded from the chopping plane coordinate to the
        // downstream patch
        // Defaults to 0.5*max-x-coordinate in the wire
        //choppingPlaneXCoordinate 0.XXX;

        // Number of layers in the new mesh
        //nLayers 10;
        //nLayers 100;
        nLayers 50;

        // Max cell size is the new mesh
        maxCellSize 0.0009;

        // Use Nagata smoothing patches when creating the surface STL
        // Defaults to true
        useNagataPatches yes;
        useNagataPatches no;
    }

    movingCells     wire;
    frontFaces      wireInletFaces;
    backFaces       wireOutletFaces;
    wireInlet       wireUpstream;
    wireOutlet      wireDownstream;

    // Defaults to current position
    //wireEndingLocation 0.02;

    // Defaults to current cell widths at patches
    //targetLayerThickness 0.001;

    wireFlowDirection x;
    meshSmoothing   no;
    meshSmoothingCoeffs
    {
        // Frequency of time-steps at which smoothing occurs. 1 means every time-
        /// step, while 10 means every 10th time-step
        smoothingFrequency 10;

        type  cfMeshImproveMeshQuality;

        cfMeshImproveMeshQualityCoeffs
        {
            // Near boundary smoothing
            // Increasing the iterations and nLayers improves smoothing at the
            // expense of computational time
            nIterationsNearBoundaries 10;
            nLayers                   20;

            // Optional: smoothSurface
            smoothSurface             yes;
            nSurfaceIterations        10;

            // Region to be smoother
            cellZones                 1 ( wire );

            // Advect all solution fields (ALE) and boundary advection settings
            advectFields              true;

            // Sub-steps are used when explicitly advecting the fields and the
            // max Courant number is specified here
            maxCourantNumber          0.1;

            // Approach used to calculate boundary values after smoothing
            extrapolateBoundaries     no;
            zeroGradientBoundaries    yes;
            frozenBoundaries          no;
            finiteAreaBoundaryAdvection no;
            patchFieldsToMap
            (
                wireContact wireUpstream wireDownstream
                wedgeBack wedgeFront
                wireSymmetryY wireSymmetryZ
            );

            // Patches that should stay flat
            flatPatches               ( wireUpstream wireDownstream );

            // Patches that are not smoothed
            //fixedPatches     ( );
        }
    }
}


