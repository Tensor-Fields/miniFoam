FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      DD;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    loading
    {
        //type           fixedDisplacement;

        /// Make sure you use s4f implementation, available in libminiFoamBCs
        type           solids4FoamFixedDisplacement;

        displacementSeries
        {
            "fileName|file"       "$FOAM_CASE/constant/timeVsDisp";
            outOfBounds    clamp;
        }
        value          uniform ( 0 0 0 );
    }

    dieContact
    {
        type            solidContact;
        master          yes;

        //regionOfInterest ( -1e+300 -1e+300 -1e+300 ) ( 1e+300 1e+300 1e+300 );

        //regionOfInterestTopCorner ( 1e+300 1e+300 1e+300 );

        //regionOfInterestBottomCorner ( -1e+300 -1e+300 -1e+300 );

        //writeZoneVTK    false;

        //writePointDistanceFields false;

        //scaleFaceTractionsNearDownstreamPatch false;

        rigidMaster     yes;
        shadowPatch     billetContact;
        normalContactModel standardPenalty;
        standardPenaltyNormalModelDict
        {
            penaltyScale             1;
            relaxationFactor         0.02;
            infoFrequency   10;
            adjustPenaltyScale yes;
            adjustPenaltyScaleDict
            {
                //maxPenaltyScale 20;
                maxPenaltyScale 1;
                minPenaltyScale 0.01;
                targetAveragePenetration 8e-06;
            }
        }

        //frictionContactModel frictionless;

        frictionContactModel standardPenalty;
        standardPenaltyFrictionModelDict
        {
            relaxationFactor 0.02;
            penaltyScale 2.3;
            frictionLaw     coulomb;
            frictionLawDict
            {
                frictionCoeff   0.5;
            }
        }

        useNewPointDistanceMethod false;

        projectPointsToPatchBoundary false;

        checkPointDistanceOrientations false;

        usePrevCandidateMasterNeighbors false;

        secondOrder     false;

        setEffectiveTraction false;

        relaxationFactor 1;

        gradient        uniform (0 0 0);

        value           uniform (0 0 0);
        traction        uniform (0 0 0);
        pressure        uniform 0;
    }
    billetContact
    {
        type            solidContact;

        adjustPenaltyFactor true;

        adjustPenalty   true;

        secondOrder     false;

        setEffectiveTraction false;

        relaxationFactor 1;

        master          no;

        shadowPatch     dieContact;

        regionOfInterest ( -1e+300 -1e+300 -1e+300 ) ( 1e+300 1e+300 1e+300 );

        regionOfInterestTopCorner ( 1e+300 1e+300 1e+300 );

        regionOfInterestBottomCorner ( -1e+300 -1e+300 -1e+300 );

        writeZoneVTK    false;

        writePointDistanceFields false;

        scaleFaceTractionsNearDownstreamPatch false;
        gradient        uniform (0 0 0);
        value           uniform (1.816e-05 0 0);
        traction        uniform (0 0 0);
        pressure        uniform 0;
    }

    symmPlane
    {
        //type            solidSymmetry;
        //patchType       symmetryPlane;
        type       symmetryPlane;
        value           uniform (0 0 0);
    }

    ".*Back|.*Front"
    {
        //type            solidWedge;
        //patchType       wedge;
        // For now, materialModel does not work with wedge, it accepts
        // solidWedge only.
        type            wedge;
        value           uniform (0 0 0);
    }

    axis
    {
        type            empty;
    }
}

