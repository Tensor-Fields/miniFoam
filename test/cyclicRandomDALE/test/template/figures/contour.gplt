set datafile separator ","
set term wxt
#set term pngcairo enhanced font 'Arial,10'
#set output 'contour_plot.png'

set title 'Contour Lines from ParaView CSV'
set xlabel 'X'
set ylabel 'Y'
set key outside
set key title "Contour Value"

plot for [i=0:2] 'contour.csv' index i using 1:2 with lines linetype i+1 title sprintf("Contour = %d", (i+1)*10)

