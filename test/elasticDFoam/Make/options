ifeq ($(WM_PROJECT), foam)
    VER := $(shell expr `echo $(WM_PROJECT_VERSION)` \>= 4.1)
    ifeq ($(VER), 1)
        VERSION_SPECIFIC_INC = -DFOAMEXTEND=41
    else
        VERSION_SPECIFIC_INC = -DFOAMEXTEND=40
    endif
else
    VERSION_SPECIFIC_INC = \
    -DOPENFOAMESIORFOUNDATION -I$(LIB_SRC)/dynamicFvMesh/lnInclude/
    ifneq (,$(findstring v,$(WM_PROJECT_VERSION)))
        VERSION_SPECIFIC_INC += -DOPENFOAMESI
    else
        VERSION_SPECIFIC_INC += -DOPENFOAMFOUNDATION
    endif
endif

EXE_INC = \
	-DFULLDEBUG -g -O0 \
    -Wno-attributes \
    $(VERSION_SPECIFIC_INC) \
    -I/root/foam/root-4.0/src/meshSmoothers/lnInclude \
    -I/root/foam/root-4.0/src/solidModelsBekaert/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/finiteArea/lnInclude \
    -I$(LIB_SRC)/sampling/lnInclude \
    -I$(LIB_SRC)/postProcessing/foamCalcFunctions/lnInclude \
    -I$(LIB_SRC)/dynamicMesh/dynamicMesh/lnInclude \
    -I$(LIB_SRC)/dynamicMesh/topoChangerFvMesh/lnInclude \
    -I$(LIB_SRC)/dynamicMesh/dynamicFvMesh/lnInclude

EXE_LIBS = \
    -L$(FOAM_USER_LIBBIN) \
	-L"/usr/lib/gcc/x86_64-linux-gnu/7" \
    -lmeshSmoothers \
    -lmeshLibrary \
    -lprocessLine \
    -lgsl -lgslcblas \
    -lsolidModelsBekaert \
    -lcontactModels \
    -lfiniteVolume \
    -lfiniteArea \
    -lmeshTools \
    -lsampling \
    -lfoamCalcFunctions \
    -ldynamicFvMesh \
    -ltopoChangerFvMesh \
    -lmetisDecomp \
    -llduSolvers \
    -lextrudeModel \
    -lgfortran \
    $(FOAM_USER_LIBBIN)/Umat_homogdam_2.30e.o \
    -lceitHomogStressAtIntPoint    
