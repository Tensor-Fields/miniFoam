#!/bin/bash

# Only execute the script from this directory
cd ${0%/*} || exit 1

# Load Bekaert bash functions
source bekaertFunctions.sh

echo
echo "[$(date +'%Y-%m-%d at %H:%M:%S')]: process line start"
echo

# Record start time so the elapsed time can be calculated
START_TIME=$(date +%s)

# Enable/disable individual passes
runDrawing1=false
runDrawing2=false
runDrawing3=false
runDrawing4=false
runDrawing5=false
            
runRolling1=true
runRolling2=true
runRolling3=true
runRolling4=true
runRolling5=true
createSummary=false

# Run drawing 1
if [[ "${runDrawing1}" == true ]];
then
    echo "[$(date +'%Y-%m-%d at %H:%M:%S')]: drawing1"
    bekaert::runPass \
        drawing1 templateCase modifiersDrawing1 \
        > log.drawing1.stdout 2> log.drawing1.stderr
    bekaert::secsToHuman "$(($(date +%s) - ${START_TIME}))"
fi

# Run drawing 2
if [[ "${runDrawing2}" == true ]];
then
    echo "[$(date +'%Y-%m-%d at %H:%M:%S')]: drawing2"
    bekaert::runPass \
        drawing2 templateCase modifiersDrawing2 \
        > log.drawing2.stdout 2> log.drawing2.stderr
    bekaert::secsToHuman "$(($(date +%s) - ${START_TIME}))"
fi

# Run drawing 3
if [[ "${runDrawing3}" == true ]];
then
    echo "[$(date +'%Y-%m-%d at %H:%M:%S')]: drawing3"
    bekaert::runPass \
        drawing3 templateCase modifiersDrawing3 \
        > log.drawing3.stdout 2> log.drawing3.stderr
    bekaert::secsToHuman "$(($(date +%s) - ${START_TIME}))"
fi

# Run drawing 4
if [[ "${runDrawing4}" == true ]];
then
    echo "[$(date +'%Y-%m-%d at %H:%M:%S')]: drawing4"
    bekaert::runPass \
        drawing4 templateCase modifiersDrawing4 \
        > log.drawing4.stdout 2> log.drawing4.stderr
    bekaert::secsToHuman "$(($(date +%s) - ${START_TIME}))"
fi

# Run drawing 5
if [[ "${runDrawing5}" == true ]];
then
    echo "[$(date +'%Y-%m-%d at %H:%M:%S')]: drawing5"
    bekaert::runPass \
        drawing5 templateCase modifiersDrawing5 \
        > log.drawing5.stdout 2> log.drawing5.stderr
    bekaert::secsToHuman "$(($(date +%s) - ${START_TIME}))"
fi
# Run rolling 1
if [[ "${runRolling1}" == true ]];
then
    echo "[$(date +'%Y-%m-%d at %H:%M:%S')]: rolling 1"
    bekaert::runPass \
        rolling1 templateCase modifiersRolling1 \
        > log.rolling1.stdout 2> log.rolling1.stderr
    bekaert::secsToHuman "$(($(date +%s) - ${START_TIME}))"
fi

# Run rolling 2
if [[ "${runRolling2}" == true ]];
then
    echo "[$(date +'%Y-%m-%d at %H:%M:%S')]: rolling 2"
    bekaert::runPass \
        rolling2 templateCase modifiersRolling2 \
        > log.rolling2.stdout 2> log.rolling2.stderr
    bekaert::secsToHuman "$(($(date +%s) - ${START_TIME}))"
fi

# Run rolling 3
if [[ "${runRolling3}" == true ]];
then
    echo "[$(date +'%Y-%m-%d at %H:%M:%S')]: rolling 3"
    bekaert::runPass \
        rolling3 templateCase modifiersRolling3 \
        > log.rolling3.stdout 2> log.rolling3.stderr
    bekaert::secsToHuman "$(($(date +%s) - ${START_TIME}))"
fi

# Run rolling 4
if [[ "${runRolling4}" == true ]];
then
    echo "[$(date +'%Y-%m-%d at %H:%M:%S')]: rolling 4"
    bekaert::runPass \
        rolling4 templateCase modifiersRolling4 \
        > log.rolling4.stdout 2> log.rolling4.stderr
    bekaert::secsToHuman "$(($(date +%s) - ${START_TIME}))"
fi

# Run rolling 5
if [[ "${runRolling5}" == true ]];
then
    echo "[$(date +'%Y-%m-%d at %H:%M:%S')]: rolling 5"
    bekaert::runPass \
        rolling5 templateCase modifiersRolling5 \
        > log.rolling5.stdout 2> log.rolling5.stderr
    bekaert::secsToHuman "$(($(date +%s) - ${START_TIME}))"
fi

if [[ "${createSummary}" == true ]];
then
    echo "[$(date +'%Y-%m-%d at %H:%M:%S')]: post processing"
    bekaert::createVirtualTwinResultsSummary \
        summary ./templateCase/template.gnuplot ./templateCase/paraviewScriptImages.py \
        "" "" drawing1 rolling1 rolling2 rolling3 \
        > log.createSummary.stdout 2> log.createSummary.stderr
    bekaert::secsToHuman "$(($(date +%s) - ${START_TIME}))"
fi

echo
echo "[$(date +'%Y-%m-%d at %H:%M:%S')]: process line end"
bekaert::secsToHuman "$(($(date +%s) - ${START_TIME}))"
echo
