FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

d2dt2Schemes
{
    default         Euler;
}

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    grad(DU)        extendedLeastSquares 0;
    grad(sigmaHyd)  extendedLeastSquares 0;
    grad((U_0+DU))  extendedLeastSquares 0;

    // Gradient fields also used for advecting fiels with MUSCL
    default         cellLimited extendedLeastSquares 0 1;
}

divSchemes
{
    default         Gauss linear;
    advectFields    Gauss upwind;
    //advectFields    Gauss MUSCL;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

snGradSchemes
{
    snGrad(DU)      corrected;
}

interpolationSchemes
{
    default         linear;
    //V               skewCorrected linear;
}


