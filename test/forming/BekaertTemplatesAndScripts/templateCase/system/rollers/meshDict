FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/rollers";
    object      meshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Mandatory: specifies the number of rolls and their configuration. Options
// are:
// - twoHighRolls: top and bottom rolls
// - sideRolls: top, bottom, right and left rolls
// - edgeRolls: right and left rolls
rollSetup       twoHighRolls;

// Optional: specifies the symmetry, which dictates the quadrants of the
// geometry be meshed
// Options are none, posY, negY, posZ, negZ and axiSymmetric
// Defaults to none (mesh entire geoemetry)
symmetryType    none;

"twoHighRollsDict|sideRollsDict|edgeRollsDict"
{
    // The settings for each of the four rolls are given in separate dicts
    // below, followed by some general settings
    topRoll
    {
        //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        //    Geometry
        //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        // The roller geometry should be specified using one of the following
        // four methods:
        // 1. flatRoller
        // 2. dxfFileRoller
        // 3. geometryFileRoller and optional mode (interpolation type)
        // 4. surfaceFileRoller and optional mode (interpolation type)
        // In addition, all methods must specify the inner and outer roller
        // diameter and the roller width

        // 1. Flat roll
        // type            flatRoller;

        // 2. DXF
        //type            dxfFileRoller;
        //dxfFile         "roll.dxf";

        // 3. Geometry file (simple text format) and mode
        // which defaults to "b-spline" which should always be used
        type            geometryFileRoller;
        geometryFile    "topRoll.txt";
        mode            "b-spline";

        // 4. Surface file and mode as above
        // type            surfaceFileRoller;
        // surfaceFile     "roll.fms";
        // interpolationType "b-spline";

        // Inner diameter
        innerDiameter   0.06;

        // Outer diameter (outermost point for profiled rollers)
        outerDiameter   0.4;

        // Width
        rollWidth       0.07;

        //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        //    Mesh
        //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

        // Mandatory: max cell size; this allows the cell size in the interior of
        // the wire to be set larger than at the contact surface
        maxCellSize     0.005;

        // Optional: cell size on contact surface. If not specified, then the
        // cell size depends on the geometryTolerance below
        contactCellSize 0.001;

        // Optional: specofy the number of cells around the roller, not
        // including the higher density near the expected wire contact given by
        // contactLength
        // Defaults to 20
        circumferentialResolution 30;

        // Optional: scaling in the cirumferential direction of the arc of
        // the roller that will come into contact 
        // Defaults to 1.0
        circumScaling   0.2;

        // Optional: number of layers of cells of the same size between jumps in
        // mesh density. Using greater than 0 allows for a smoother transition in
        // mesh grading in the roller radial direction
        // If maxCellSize and contactCellSize are the same then this does nothing
        // Defaults to 0
        nAdditionalLayers 2;

        // Optional: additional mesh controls
        axialGrading    1;
        axialScaling    1;
        radialGrading   1;
        radialScaling   1;
        circumGrading   1.2;

        // Optional: min number of faces in a patch. This setting seems to be for
        // controlling small patches, which is not an issue for the wire
        // It is not clear if it is used at all by the wire
        // Defaults to 2
        // minNumFacesBetweenFeatures 2;

        // Optional: allows specification of finer cells in the centre of the
        // roller contact patch
        contactWidth    0.025;

        // Optional: centre the roller in its axial direction about the origin
        // Defaults to no
        // centreInAxialDirection no;
        // extraContactAngle 360;
    }
    bottomRoll
    {
        //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        //    Geometry
        //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        // See description in topRoll

        // 1. Flat roll
        // type            flatRoller;

        // 2. DXF
        // type            dxfFileRoller;
        // dxfFile         "roll.dxf";

        // 3. Geometry file (simple text format) and mode
        // which defaults to "b-spline" which should always be used
        type            geometryFileRoller;
        geometryFile    "bottomRoll.txt";
        mode            "b-spline";

        // 4. Surface file and mode as above
        // type            surfaceFileRoller;
        // surfaceFile     "roll.fms";
        // interpolationType "b-spline";

        // Inner diameter
        innerDiameter   0.06;

        // Outer diameter (outermost point for profiled rollers)
        outerDiameter   0.4;

        // Width
        rollWidth       0.07;

        //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        //    Mesh
        //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

        // Mandatory: max cell size; this allows the cell size in the interior of
        // the wire to be set larger than at the contact surface
        maxCellSize     0.005;

        // Optional: cell size on contact surface. If not specified, then the
        // cell size depends on the geometryTolerance below
        contactCellSize 0.001;

        // Optional: specofy the number of cells around the roller, not
        // including the higher density near the expected wire contact given by
        // contactLength
        // Defaults to 20
        circumferentialResolution 20;

        // Optional: scaling in the cirumferential direction of the arc of
        // the roller that will come into contact 
        // Defaults to 1.0
        circumScaling   0.2;

        // Optional: number of layers of cells of the same size between jumps in
        // mesh density. Using greater than 0 allows for a smoother transition in
        // mesh grading in the roller radial direction
        // If maxCellSize and contactCellSize are the same then this does nothing
        // Defaults to 0
        nAdditionalLayers 2;

        // Optional: additional mesh controls
        axialGrading    1;
        axialScaling    1;
        radialGrading   1;
        radialScaling   1;
        circumGrading   1.2;

        // Optional: min number of faces in a patch. This setting seems to be for
        // controlling small patches, which is not an issue for the wire
        // It is not clear if it is used at all by the wire
        // Defaults to 2
        // minNumFacesBetweenFeatures 2;

        // Optional: allows specification of finer cells in the centre of the
        // roller contact patch
        contactWidth    0.025;

        // Optional: centre the roller in its axial direction about the origin
        // Defaults to no
        // centreInAxialDirection no;
        // extraContactAngle 360;
    }
    rightRoll
    {
        //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        //    Geometry
        //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        // See description in topRoll

        // 1. Flat roll
        // type            flatRoller;

        // 2. DXF
        // type            dxfFileRoller;
        // dxfFile         "roll.dxf";

        // 3. Geometry file (simple text format) and mode
        // which defaults to "b-spline" which should always be used
        type            geometryFileRoller;
        geometryFile    "rightRoll.txt";
        mode            "b-spline";

        // 4. Surface file and mode as above
        // type            surfaceFileRoller;
        // surfaceFile     "roll.fms";
        // interpolationType "b-spline";

        // Inner diameter
        innerDiameter   0.2;

        // Outer diameter (outermost point for profiled rollers)
        outerDiameter   0.32;

        // Width
        rollWidth       0.07;

        //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        //    Mesh
        //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

        // Mandatory: max cell size; this allows the cell size in the interior of
        // the wire to be set larger than at the contact surface
        maxCellSize     0.005;

        // Optional: cell size on contact surface. If not specified, then the
        // cell size depends on the geometryTolerance below
        contactCellSize 0.001;

        // Optional: specofy the number of cells around the roller, not
        // including the higher density near the expected wire contact given by
        // circumScaling
        // Defaults to 20
        circumferentialResolution 20;

        // Optional: scaling in the cirumferential direction of the arc of
        // the roller that will come into contact 
        // Defaults to 1.0
        circumScaling   0.2;

        // Optional: number of layers of cells of the same size between jumps in
        // mesh density. Using greater than 0 allows for a smoother transition in
        // mesh grading in the roller radial direction
        // If maxCellSize and contactCellSize are the same then this does nothing
        // Defaults to 0
        nAdditionalLayers 2;

        // Optional: additional mesh controls
        axialGrading    1;
        axialScaling    1;
        radialGrading   1;
        radialScaling   1;
        circumGrading   1.2;

        // Optional: min number of faces in a patch. This setting seems to be for
        // controlling small patches, which is not an issue for the wire
        // It is not clear if it is used at all by the wire
        // Defaults to 2
        // minNumFacesBetweenFeatures 2;

        // Optional: allows specification of finer cells in the centre of the
        // roller contact patch
        contactWidth    0.025;

        // Optional: centre the roller in its axial direction about the origin
        // Defaults to no
        // centreInAxialDirection no;
    }
    leftRoll
    {
        //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        //    Geometry
        //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        // See description in topRoll

        // 1. Flat roll
        // type            flatRoller;

        // 2. DXF
        // type            dxfFileRoller;
        // dxfFile         "roll.dxf";

        // 3. Geometry file (simple text format) and mode
        // which defaults to "b-spline" which should always be used
        type            geometryFileRoller;
        geometryFile    "leftRoll.txt";
        mode            "b-spline";

        // 4. Surface file and mode as above
        // type            surfaceFileRoller;
        // surfaceFile     "roll.fms";
        // interpolationType "b-spline";

        // Inner diameter
        innerDiameter   0.2;

        // Outer diameter (outermost point for profiled rollers)
        outerDiameter   0.32;

        // Width
        rollWidth       0.07;

        //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        //    Mesh
        //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

        // Mandatory: max cell size; this allows the cell size in the interior of
        // the wire to be set larger than at the contact surface
        maxCellSize     0.005;

        // Optional: cell size on contact surface. If not specified, then the
        // cell size depends on the geometryTolerance below
        contactCellSize 0.001;

        // Optional: specofy the number of cells around the roller, not
        // including the higher density near the expected wire contact given by
        // contactLength
        // Defaults to 20
        circumferentialResolution 20;

        // Optional: scaling in the cirumferential direction of the arc of
        // the roller that will come into contact 
        // Defaults to 1.0
        circumScaling   0.2;

        // Optional: number of layers of cells of the same size between jumps in
        // mesh density. Using greater than 0 allows for a smoother transition in
        // mesh grading in the roller radial direction
        // If maxCellSize and contactCellSize are the same then this does nothing
        // Defaults to 0
        nAdditionalLayers 2;

        // Optional: additional mesh controls
        axialGrading    1;
        axialScaling    1;
        radialGrading   1;
        radialScaling   1;
        circumGrading   1.2;

        // Optional: min number of faces in a patch. This setting seems to be for
        // controlling small patches, which is not an issue for the wire
        // It is not clear if it is used at all by the wire
        // Defaults to 2
        // minNumFacesBetweenFeatures 2;

        // Optional: allows specification of finer cells in the centre of the
        // roller contact patch
        contactWidth    0.025;

        // Optional: centre the roller in its axial direction about the origin
        // Defaults to no
        // centreInAxialDirection no;
    }

    //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    // General settings for all rolls
    //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    // Optional: tightest tolerance to which the geometry is matched
    // Defaults to 1e-04
    // geometryTolerance 1e-04;

    // Place all roller contact patches in the same contact patch. This is
    // currenty required to be yes by the solver
    singleRollerContactPatch yes;

    // Length of refined circumferential region which will come into contact
    // with the wire. We generally expect to roller one full length of wire so
    // this should be greater than the wire length
    contactLength   0.12;

    // Optional: additional angle to include in contact patches
    // Defaults to 10
    // extraContactAngle 360;

    // Create additional contact patches for roll-to-roll contact
    // Defaults to no
    // contact         no;
    // contactDict
    // {
    //     writeRollProfiles no;
    //     contactDistanceTolerance 1e-05;
    // }
}

// Optional: alternative appraoch to how boundary cells are generated. It
// results in a slightly finer mesh when enabled
// Only relevant for non-circular wires
// Defaults to 0
// keepCellsIntersectingBoundary 1;

// Optional: split the boundary layer of cells at the contact patch into layers
// boundaryLayers
// {
//     nLayers         2;
//     thicknessRatio  1.1;
//     optimiseLayer   1;
//     allowDiscontinuity 1;
//     untangleLayer   1;
//     optimisationParameters
//     {
//         nSmoothNormals  10;
//         maxNumIterations 5;
//         featureSizeFactor 0.4;
//         recalculateNormals 1;
//         relThicknessTol 0.1;
//     }
//     symmetryPlaneLayerTopology 1;
// }

// Names of patches
#include "${FOAM_CASE}/system/rollingMillPatchNames"

