FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      DU;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 1 0 0 0 0 0 ];

internalField   uniform ( 0 0 0 );

boundaryField
{
    //---------------------------------
    // Wire boundary conditions
    //---------------------------------

    wireContact
    {
        type            solidContact;
        //type            solidSegmentContact;

        pairPatch       rollerContact;
        shadowPatch     rollerContact;
        //regionOfInterestBottomCorner ( -0.04 -0.01 -0.015 );
        //regionOfInterestTopCorner ( 0.04 0.01 0.015 );
        master          no;
        rigid           no;
        gradient        uniform (0 0 0);
        value           uniform (0 0 0);
        traction        uniform (0 0 0);
        pressure        uniform 0;
    }

    wireUpstream
    {
        #include "$FOAM_CASE/constant/DU.BC.wireUpstream";
    }

    wireDownstream
    {
        #include "$FOAM_CASE/constant/DU.BC.wireDownstream";
    }

    wireSymmetryY
    {
        type         solidSymmetry;
        patchType    symmetryPlane;
        value        uniform (0 0 0);
    }

    wireSymmetryZ
    {
        type         solidSymmetry;
        patchType    symmetryPlane;
        value        uniform (0 0 0);
    }

    //---------------------------------
    // Roller boundary conditions
    //---------------------------------

    // Roller axes
    topRollRollerAxis
    {
        type            roller;
        value           uniform (0 0 0);

        // Specified displacemet or give a translationDuringPositioningFile
        // Note: the displacement found in the file
	// (translationDuringPositioningFile?) is subtracted from the
        // displacement applied to the patch
        displacement    (0 0.000675 0);
        translationDuringPositioningFile "$FOAM_CASE/translationTopRoll.txt";

        dispRampTime    0.01;
        rpm             15;
        currentRpm      0;
        rotationRampTime 0.01;
        rotationAxis    (0 0 1);
        //initialRotationOrigin (-0.000197223138385 0.207067948386 -2.0989190522e-18);
        steadyStateRotationOriginFile "$FOAM_CASE/pointOnAxis_topRoll.txt";
        currentAxisDisplacement (0 0 0);
        curAngle        0;
    }
    bottomRollRollerAxis
    {
        type            roller;
        value           uniform (0 0 0);

        // Specified displacemet or give a translationDuringPositioningFile
        // Note: the displacement found in the file is subtracted from the
        // displacement applied to the patch
        displacement    (0 0 0);
        translationDuringPositioningFile "$FOAM_CASE/translationBottomRoll.txt";

        dispRampTime    0.01;
        rpm             15;
        currentRpm      0;
        rotationRampTime 0.01;
        rotationAxis    (0 0 -1);
        //initialRotationOrigin (-0.000197223138385 -0.207067948386 -4.18867867249e-18);
        steadyStateRotationOriginFile "$FOAM_CASE/pointOnAxis_bottomRoll.txt";
        currentAxisDisplacement (0 0 0);
        curAngle        0;
    }
    rightRollRollerAxis
    {
        type            roller;
        value           uniform (0 0 0);

        // Specified displacemet or give a translationDuringPositioningFile
        // Note: the displacement found in the file is subtracted from the
        // displacement applied to the patch
        displacement    (0 0 0);
        translationDuringPositioningFile "$FOAM_CASE/translationRightRoll.txt";

        dispRampTime    0.01;
        rpm             15;
        currentRpm      0;
        rotationRampTime 0.01;
        rotationAxis    (0 -1 0);
        //initialRotationOrigin (-0.000197223138385 -0.207067948386 -4.18867867249e-18);
        steadyStateRotationOriginFile "$FOAM_CASE/pointOnAxis_rightRoll.txt";
        currentAxisDisplacement (0 0 0);
        curAngle        0;
    }
    leftRollRollerAxis
    {
        type            roller;
        value           uniform (0 0 0);

        // Specified displacemet or give a translationDuringPositioningFile
        // Note: the displacement found in the file is subtracted from the
        // displacement applied to the patch
        displacement    (0 0 0);
        translationDuringPositioningFile "$FOAM_CASE/translationLeftRoll.txt";

        dispRampTime    0.01;
        rpm             15;
        currentRpm      0;
        rotationRampTime 0.01;
        rotationAxis    (0 1 0);
        //initialRotationOrigin (-0.000197223138385 -0.207067948386 -4.18867867249e-18);
        steadyStateRotationOriginFile "$FOAM_CASE/pointOnAxis_leftRoll.txt";
        currentAxisDisplacement (0 0 0);
        curAngle        0;
    }

    // Roller backs
    topRollRollerBack
    {
        type            solidTraction;
        gradient        uniform (0 0 0);
        traction        uniform (0 0 0);
        pressure        uniform 0;
        value           uniform (0 0 0);
    }
    bottomRollRollerBack
    {
        type            solidTraction;
        gradient        uniform (0 0 0);
        traction        uniform (0 0 0);
        pressure        uniform 0;
        value           uniform (0 0 0);
    }
    rightRollRollerBack
    {
        type            solidTraction;
        gradient        uniform (0 0 0);
        traction        uniform (0 0 0);
        pressure        uniform 0;
        value           uniform (0 0 0);
    }
    leftRollRollerBack
    {
        type            solidTraction;
        gradient        uniform (0 0 0);
        traction        uniform (0 0 0);
        pressure        uniform 0;
        value           uniform (0 0 0);
    }

    // Roller fronts
    topRollRollerFront
    {
        type            solidTraction;
        traction        uniform (0 0 0);
        pressure        uniform 0;
        value           uniform (0 0 0);
    }
    bottomRollRollerFront
    {
        type            solidTraction;
        traction        uniform (0 0 0);
        pressure        uniform 0;
        value           uniform (0 0 0);
    }
    rightRollRollerFront
    {
        type            solidTraction;
        traction        uniform (0 0 0);
        pressure        uniform 0;
        value           uniform (0 0 0);
    }
    leftRollRollerFront
    {
        type            solidTraction;
        traction        uniform (0 0 0);
        pressure        uniform 0;
        value           uniform (0 0 0);
    }

    "rollerContact|dieContact"
    {
        type            solidContact;
        //type            solidSegmentContact;

        shadowPatch     wireContact;
        pairPatch       wireContact;
        useNewPointDistanceMethod no;
        usePrevCandidateMasterNeighbors no;
        master          yes;
        rigidMaster     no;
        //regionOfInterestBottomCorner ( -0.04 -0.01 -0.015 );
        //regionOfInterestTopCorner ( 0.04 0.01 0.015 );

        moveZonesUsingLS yes;
        contactZoneDetection PATCH_AUG;
        boundingVolumeDetection OBB_OBB;
        polygonDetection SAT;

        normalContactModel standardPenalty;
        //normalContactModel segmentStandardPenalty;
        standardPenaltyNormalModelDict
        {
            penaltyScale    1;
            relaxationFactor 0.05;
            infoFrequency   10;
            adjustPenaltyScale yes;
            adjustPenaltyScaleDict
            {
                maxPenaltyScale 20;
                minPenaltyScale 0.01;
                targetAveragePenetration 8e-06;
            }
        }
        segmentStandardPenaltyNormalModelDict
        {
            penaltyScale    1;
            relaxationFactor 0.02;
        }

        frictionContactModel standardPenalty;
        // frictionContactModel segmentStandardPenalty;
        standardPenaltyFrictionModelDict
        {
            penaltyScale    1;
            relaxationFactor 0.02;
            infoFrequency   10;
            frictionLaw     coulomb;
            frictionLawDict
            {
                frictionCoeff   0.1;
            }
        }
        segmentStandardPenaltyFrictionModelDict
        {
            penaltyScale    1;
            relaxationFactor 0.02;
            frictionCoeff   0.1;
        }

        traction        uniform (0 0 0);
        pressure        uniform 0;
        value           uniform (0 0 0);
    }

    // Single roller to air
    rollerToAir
    {
        type            solidTraction;
        traction        uniform (0 0 0);
        pressure        uniform 0;
        value           uniform (0 0 0);
    }

    topRollRollerSymmetryY
    {
        type         solidSymmetry;
        patchType    symmetryPlane;
        value        uniform (0 0 0);
    }

    topRollRollerSymmetryZ
    {
        type         solidSymmetry;
        patchType    symmetryPlane;
        value        uniform (0 0 0);
    }

    bottomRollRollerSymmetryY
    {
        type         solidSymmetry;
        patchType    symmetryPlane;
        value        uniform (0 0 0);
    }

    bottomRollRollerSymmetryZ
    {
        type         solidSymmetry;
        patchType    symmetryPlane;
        value        uniform (0 0 0);
    }

    rightRollRollerSymmetryY
    {
        type         solidSymmetry;
        patchType    symmetryPlane;
        value        uniform (0 0 0);
    }

    rightRollRollerSymmetryZ
    {
        type         solidSymmetry;
        patchType    symmetryPlane;
        value        uniform (0 0 0);
    }

    leftRollRollerSymmetryY
    {
        type         solidSymmetry;
        patchType    symmetryPlane;
        value        uniform (0 0 0);
    }

    leftRollRollerSymmetryZ
    {
        type         solidSymmetry;
        patchType    symmetryPlane;
        value        uniform (0 0 0);
    }

    //---------------------------------
    // Die boundary conditions
    //---------------------------------

    // Die entrance and exit are for bekaertSpecs
    // more realistically they should be combined with
    // the dieContact patch

    dieEntrance
    {
        type            fixedDisplacement;
        value           uniform ( 0 0 0 );
    }

    dieExit
    {
        type            fixedDisplacement;
        value           uniform ( 0 0 0 );
    }


    dieDownstream
    {
        type            fixedDisplacement;
        value           uniform ( 0 0 0 );
    }

    dieOuter
    {
        type            fixedDisplacement;
        value           uniform ( 0 0 0 );
    }

    dieUpstream
    {
        type            solidTraction;
        traction        uniform ( 0 0 0 );
        pressure        uniform 0;
        value           uniform ( 0 0 0 );
    }

    // dieContact
    // {
    //     type            solidContact;
    //     shadowPatch     wireContact;
    //     pairPatch       wireContact;
    //     useNewPointDistanceMethod no;
    //     usePrevCandidateMasterNeighbors no;
    //     master          yes;
    //     rigidMaster     no;
    //     // regionOfInterestBottomCorner ( -0.04 -0.01 -0.015 );
    //     // regionOfInterestTopCorner ( 0.04 0.01 0.015 );
    //     normalContactModel standardPenalty;
    //     standardPenaltyNormalModelDict
    //     {
    //         penaltyScale    1;
    //         relaxationFactor 0.05;
    //         infoFrequency   10;
    //         adjustPenaltyScale yes;
    //         adjustPenaltyScaleDict
    //         {
    //             maxPenaltyScale 20;
    //             minPenaltyScale 0.5;
    //             targetAveragePenetration 8e-06;
    //         }
    //     }
    //     frictionContactModel standardPenalty;
    //     standardPenaltyFrictionModelDict
    //     {
    //         penaltyScale    1;
    //         relaxationFactor 0.02;
    //         infoFrequency   10;
    //         frictionLaw     coulomb;
    //         frictionLawDict
    //         {
    //             frictionCoeff   0.05;
    //         }
    //     }
    //     value           uniform ( 0 0 0 );
    // }

    dieSymmetryY
    {
        type         solidSymmetry;
        patchType    symmetryPlane;
        value        uniform (0 0 0);
    }

    dieSymmetryZ
    {
        type         solidSymmetry;
        patchType    symmetryPlane;
        value        uniform (0 0 0);
    }

    //---------------------------------
    // Wire boundary conditions
    //---------------------------------

    wedgeBack
    {
        type         solidWedge;
        patchType    wedge;
        value        uniform (0 0 0);
    }

    wedgeFront
    {
        type         solidWedge;
        patchType    wedge;
        value        uniform (0 0 0);
    }
}


