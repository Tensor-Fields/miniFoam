FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/wire";
    object      mechanicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

planeStress     no;

mechanical
{
    wire
    {
        // Solve a Poisson equation to calculate the hydrostatic sigma/pressure
        // field
        solvePressureEqn  yes;

        // Scale the amount of smoothing applied to the pressure field
        // Defaults to 100
        // Set larger values (e.g. 1e4, 1e5, 1e6) will resulting in an
        // increasingly smooth pressure field
        // When using values close to 1.0 or less, oscillations may start to
        // appear
        pressureSmoothingScaleFactor 100;

        // Mises/J2
        type            elastoPlasticKirchhoff;
        rho             rho [ 1 -3 0 0 0 0 0 ] 7852;  // 7850-7855 kg/m3
        E              
	    E [ 1 -1 -2 0 0 0 0 ] 202e9;// 200-205 N/mm2 -> 202e6 N/m2; prev:1.7e+11
		                            // 210e9 N/m2 from ChatGPT
									// So, Tom should have suggested 200'000 Mpa

        nu              nu [ 0 0 0 0 0 0 0 ] 0.3;
        initialYieldStress initialYieldStress [ 1 -1 -2 0 0 0 0 ] 1000e+06; //
	    // from flatWireCalculator
        hardeningCoefficient hardeningCoefficient [ 1 -1 -2 0 0 0 0 ] 500e+06;

	//fileName "templateCase/constant/yieldStressVsPlasticStrain";
	//outOfBounds clamp;

        // Hill
        // type            elastoPlasticBatheHill;
        // rho             rho [ 1 -3 0 0 0 0 0 ] 7833;
        // E               E [ 1 -1 -2 0 0 0 0 ] 1.7e+11;
        // nu              nu [ 0 0 0 0 0 0 0 ] 0.3;
        // R11             1.1; //1.2;
        // R22             0.9; //0.8;
        // R33             0.9; //0.8;
        // R12             0.57735;
        // R23             0.4;
        // R31             0.57735;
        // sigmaY0         473e+06;
        // sigmaYInfinity  473e+06;
        // hIso            300e+06;
        // beta            0;
    }
}


