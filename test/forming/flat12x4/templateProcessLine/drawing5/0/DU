FoamFile
{
    version     2.0;
    format      binary;
    class       volVectorField;
    location    "0";
    object      DU;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    wireUpstream
    {
        fileName        "$FOAM_CASE/constant/timeVsDownstreamPressure";
        outOfBounds     clamp;
        normal          (1 0 0);
        updateTangentialDisplacement yes;
        relaxationFactor 0.025;
        type            fixedTangentialNormalPressure;
        refValue        uniform (0 0 0);
        refGradient     uniform (0 0 0);
        valueFraction   uniform (0 -0 -0 1 -0 1);
        value           uniform (0 0 0);
    }
    wireDownstream
    {
        velocity        0.25;
        type            fixedDisplacementZeroShear;
        refValue        uniform (0 0 0);
        refGradient     uniform (0 0 0);
        valueFraction   uniform (1 0 0 0 0 0);
        value           uniform (0 0 0);
    }
    wireContact
    {
        type            solidContact;

        pairPatch       rollerContact;

        shadowPatch     dieContact;

        master          no;

        rigid           no;
        gradient        uniform (0 0 0);
        value           uniform (0 0 0);
        traction        uniform (0 0 0);
        pressure        uniform 0;
    }
    wireSymmetryY
    {
        type            solidSymmetry;
        patchType       symmetryPlane;
        value           uniform (0 0 0);
    }
    wireSymmetryZ
    {
        type            solidSymmetry;
        patchType       symmetryPlane;
        value           uniform (0 0 0);
    }
    dieSymmetryY
    {
        type            solidSymmetry;
        patchType       symmetryPlane;
        value           uniform (0 0 0);
    }
    dieContact
    {
        type            solidContact;

        shadowPatch     wireContact;

        pairPatch       wireContact;

        useNewPointDistanceMethod no;

        usePrevCandidateMasterNeighbors no;

        master          yes;

        rigidMaster     no;

        moveZonesUsingLS yes;

        contactZoneDetection PATCH_AUG;

        boundingVolumeDetection OBB_OBB;

        polygonDetection SAT;

        normalContactModel standardPenalty;

        standardPenaltyNormalModelDict
        {
            penaltyScale    0.01;
            relaxationFactor 0.05;
            infoFrequency   10;
            adjustPenaltyScale yes;
            adjustPenaltyScaleDict
            {
                maxPenaltyScale 20;
                minPenaltyScale 0.01;
                targetAveragePenetration 8e-06;
            }
        }

        segmentStandardPenaltyNormalModelDict
        {
            penaltyScale    1;
            relaxationFactor 0.02;
        }

        frictionContactModel standardPenalty;

        standardPenaltyFrictionModelDict
        {
            penaltyScale    1;
            relaxationFactor 0.02;
            infoFrequency   10;
            frictionLaw     coulomb;
            frictionLawDict
            {
                frictionCoeff   0.1;
            }
        }

        segmentStandardPenaltyFrictionModelDict
        {
            penaltyScale    1;
            relaxationFactor 0.02;
            frictionCoeff   0.1;
        }
        gradient        uniform (0 0 0);
        value           uniform (0 0 0);
        traction        uniform (0 0 0);
        pressure        uniform 0;
    }
    dieDownstream
    {
        type            fixedDisplacement;
        value           uniform (0 0 0);
    }
    dieEntrance
    {
        type            fixedDisplacement;
        value           uniform (0 0 0);
    }
    dieExit
    {
        type            fixedDisplacement;
        value           uniform (0 0 0);
    }
    dieOuter
    {
        type            fixedDisplacement;
        value           uniform (0 0 0);
    }
    dieUpstream
    {
        type            solidTraction;
        gradient        uniform (0 0 0);
        traction        uniform (0 0 0);
        pressure        uniform 0;
        value           uniform (0 0 0);
    }
    dieSymmetryZ
    {
        type            solidSymmetry;
        patchType       symmetryPlane;
        value           uniform (0 0 0);
    }
}


