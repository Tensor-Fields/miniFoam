FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "";
    object      passItems;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// This file defines what passItems are present in this case, where a passItem
// can be a wire, roller (or set of rollers), die or other.

// For each passItem, the following is specified:
//     name
//         this is the name of the passItem sub-dict. The passItem mesh will be
//         temporarily located in $PASS_DIR/constant/name/polyMesh
//     meshingCommand
//         name of executable to generate the passItem. "-region name" will be
//         appended to the command. Could be e.g. generateWireMesh,
//         generate3DRollerMesh, generateDieMesh or other
//     meshSource
//         can be meshDict or existingMesh. If used, it is assumed that the
//         meshDict is located at $PASS_DIR/system/name/meshDict
//     existingCase
//         location of existing case containing a mesh
//     exisitingCaseRegion
//         optionally, we can take a region mesh from the existing case
//     remesh
//         optionally, remesh item after it has been taken from an existingCase.
//         The meshingCommand must also be specified when remesh is active
//
// In addition, there is one global option for the pass:
//     mapFields
//         fields are mapped from the exisitingCase, if specified

remeshAndSmoothWireInPreviousPass yes;
mapFields    yes;

passItems
{
    wire // passItem name
    {
        // Create new wire mesh
        // meshSource              meshDict;
        // meshingCommand          generateWireMesh;

        // Use mesh from specified case
        // existingCase gives the address of the existing case, where an
        // optional region of the mesh can be specified
        // The existingCase address is relative to the $PASS_DIR
        meshSource              existingMesh;
        existingCase            "../rolling4";
        existingCaseRegion      wire;
    }

    rollers // passItem name
    {
        meshSource              meshDict;
        meshingCommand          generate3DRollerMesh;
    }

    // die    // passItem name
    // {
    //     meshSource              meshDict;
    //     meshingCommand          generateDieMesh;
    // }
} 
