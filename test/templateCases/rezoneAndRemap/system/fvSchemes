FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         none;
    ddt(p)          DDT;
    //default         CrankNicolson 0.9;
}

gradSchemes
{
    default         none;
    //default         GRAD_1 GRAD_2;
    grad(p)         GRAD_1 GRAD_2;
}

divSchemes
{
    default         none;
    //advectFields    Gauss upwind;
    //div(phi,U)      Gauss linear;

    //div(meshPhi,p)      Gauss linear;
    //div(meshPhi,p)      Gauss quadraticFit 0.5;
    //div(meshPhi,ddt0(p))      Gauss quadraticFit 0.5;

    // To turn advection off
    //div(meshPhi,p)      off  linear;
    //div(meshPhi,p)      Gauss vanLeerDC;
    //div(meshPhi,p)      Gauss blended 0.5; // Diverges
    //div(meshPhi,p)      Gauss blended 0.1; // Diverges
    //div(meshPhi,p)      Gauss blended 0.99; // Diverges
    //div(meshPhi,p)      Gauss blended 0.90; // Diverges
    div(meshPhi,p)        MESH_PHI;
    div((-1*meshPhi),p)   MESH_PHI; // Flip flux sign
    div((1*meshPhi),p)    MESH_PHI; // Flip flux sign
}

laplacianSchemes
{
    default         none;//Gauss linear orthogonal;
}

interpolationSchemes
{
    default         banana;
