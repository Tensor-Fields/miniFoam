FoamFile
{
    class dictionary;
    object smoothMeshDict;
    version 2.0;
    format ascii;
}

//cfMeshImproveMeshQuality
//taubin
//laplacian
//volume

type laplacian;
//type cfMeshImproveMeshQuality;

laplacianCoeffs
{
    //advectFields false;
    lambda .01;  
    nCorrectors 1000;
    //mapFields false;
}

taubinCoeffs
{
    lambda 1;
    mu 1;
    nCorrectors 100;
}

volumeCoeffs
{
    lambda 1;
    nCorrectors 100;
}

cfMeshImproveMeshQualityCoeffs
{
    extrapolateBoundaries false;
    zeroGradientBoundaries false;//true;//( "left" "axis" );
    frozenBoundaries true;
    finiteAreaBoundaryAdvection false;//true;
}
