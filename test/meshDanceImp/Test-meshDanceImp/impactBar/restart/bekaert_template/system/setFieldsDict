FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volVectorFieldValue DU (0 0 0)
    volVectorFieldValue DU_0 (0 0 0)
    volVectorFieldValue DU_0_0 (0 0 0)
    volVectorFieldValue DU_0_0_0 (0 0 0)
    volVectorFieldValue U (0 0 0)
    volVectorFieldValue U_0 (0 0 0)
    volVectorFieldValue U_0_0 (0 0 0)
    volVectorFieldValue U_0_0_0 (0 0 0)
);

regions
(
    boxToCell
    {
        box (0 0 -8.72654e-05) (0.0324 0.00999962 8.72654e-05);

        // Set old displacement increments to give a velocity of 227 m/s
        // DD = velocity*timeStep
        // D_0 = -velocity*timeStep
        // D_0_0 = -velocity*2.0*timeStep
        // D_0_0_0 = -velocity*3.0*timeStep
        fieldValues
        (
            volVectorFieldValue DU (0.00001816 0 0)
            volVectorFieldValue DU_0 (0.00001816 0 0)
            volVectorFieldValue DU_0_0 (0.00001816 0 0)
            volVectorFieldValue DU_0_0_0 (0.00001816 0 0)
            //volVectorFieldValue D (0 0 0)
            volVectorFieldValue U_0 (-0.00001816 0 0)
            volVectorFieldValue U_0_0 (-0.00003632 0 0)
            volVectorFieldValue U_0_0_0 (-0.00005448 0 0)
        );
    }
);

