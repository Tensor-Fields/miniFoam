FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    billetTop
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    dieContact
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    billetContact
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    billetSide
    {
        type            solidTraction;
        traction        uniform (0 0 0);
        pressure        uniform 0;
        secondOrder     false;
        setEffectiveTraction false;
        relaxationFactor 1;
        value           uniform (0 0 0);
        gradient        uniform (0 0 0);
    }
    dieBottom
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    back
    {
        type            solidWedge;
        patchType       wedge;
        value           uniform (0 0 0);
    }
    front
    {
        type            solidWedge;
        patchType       wedge;
        value           uniform (0 0 0);
    }
    axis
    {
        type            empty;
    }
}


